# Usamos a imagem oficial do Puppeteer que já contém Chrome e dependências
FROM ghcr.io/puppeteer/puppeteer:latest

# O usuário default na imagem do puppeteer é 'pptruser'
# Vamos usar root para garantir permissões nas pastas compartilhadas (docs, .wwebjs_auth)
USER root
WORKDIR /app

# Copia package.json
COPY package*.json ./
RUN npm install

# Copia código
COPY index.js .

# A imagem oficial já define PUPPETEER_EXECUTABLE_PATH automaticamente para o Google Chrome.
# O ENTRYPOINT da imagem oficial pode interferir, então usamos um start simples:
CMD ["node", "index.js"]
