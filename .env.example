# Provider de LLM usado em generate.py (ver src/llm_provider.py).
# "anthropic" já vem implementado; implemente o seu e registre em PROVIDERS
# pra usar outro nome aqui. (ex: gemini)
LLM_PROVIDER=anthropic

# Necessária se LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Necessária se LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Necessária se LLM_PROVIDER=openai
OPENAI_API_KEY=seu_token_da_openai_aqui

WHATSAPP_TOKEN=seu_token_permanente_da_api_do_whatsapp
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id_da_meta
VERIFY_TOKEN=um_token_seguro_criado_por_voce

TELEGRAM_BOT_TOKEN=seu_token_do_botfather

SLACK_BOT_TOKEN=xoxb-seu-token-bot-do-slack
